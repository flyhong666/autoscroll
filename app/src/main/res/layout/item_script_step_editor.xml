<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="1dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="0.5dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp">

        <TextView
            android:id="@+id/tvStepIndex"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_step_index"
            android:gravity="center"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="1" />

        <TextView
            android:id="@+id/tvStepAction"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/btnStepUp"
            app:layout_constraintStart_toEndOf="@id/tvStepIndex"
            app:layout_constraintTop_toTopOf="@id/tvStepIndex"
            tools:text="点击 (540, 1200) 「点赞按钮」" />

        <TextView
            android:id="@+id/tvStepMeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="2dp"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp"
            app:layout_constraintEnd_toStartOf="@id/btnStepUp"
            app:layout_constraintStart_toEndOf="@id/tvStepIndex"
            app:layout_constraintTop_toBottomOf="@id/tvStepAction"
            tools:text="等待 500ms · 持续 60ms" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStepUp"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="36dp"
            android:layout_height="32dp"
            android:text="↑"
            android:textSize="15sp"
            android:contentDescription="@string/editor_move_up"
            app:layout_constraintEnd_toStartOf="@id/btnStepDown"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStepDown"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="36dp"
            android:layout_height="32dp"
            android:text="↓"
            android:textSize="15sp"
            android:contentDescription="@string/editor_move_down"
            app:layout_constraintEnd_toStartOf="@id/btnStepDelete"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btnStepDelete"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/editor_step_delete"
            app:icon="@drawable/ic_delete"
            app:iconSize="18dp"
            app:iconTint="?android:attr/textColorSecondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
