<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_page">

    <!-- 顶部栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="@color/bg_page">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogBack"
            style="@style/AutoScrollButton.Outline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/log_back"
            app:strokeColor="@color/purple_500"
            android:textColor="@color/purple_700" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/log_title"
            android:textSize="17sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <!-- 节点池统计（清单 #6 可观测性） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNodePoolStats"
            style="@style/AutoScrollButton.Outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/log_node_pool_stats"
            app:strokeColor="@color/purple_500"
            android:textColor="@color/purple_700" />

        <TextView
            android:id="@+id/tvNodePoolStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:background="@color/bg_card"
            android:padding="10dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 日志正文 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:scrollbars="vertical" />
    </ScrollView>

    <!-- 刷新 / 清除 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogRefresh"
            style="@style/AutoScrollButton.Outline"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/log_refresh"
            app:strokeColor="@color/purple_500"
            android:textColor="@color/purple_700" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogClear"
            style="@style/AutoScrollButton.Outline"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/log_clear"
            app:strokeColor="@color/teal_700"
            android:textColor="@color/teal_700" />
    </LinearLayout>

    <!-- 导出日志 / 导出统计 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="12dp"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogExport"
            style="@style/AutoScrollButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/log_export"
            android:textColor="@color/btn_start_text"
            app:backgroundTint="@color/btn_start_bg"
            app:cornerRadius="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogExportStats"
            style="@style/AutoScrollButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/log_export_stats"
            android:textColor="@color/btn_start_text"
            app:backgroundTint="@color/btn_start_bg"
            app:cornerRadius="18dp" />
    </LinearLayout>
</LinearLayout>
