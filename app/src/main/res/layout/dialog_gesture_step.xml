<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/custom_gesture_type"
        android:textSize="13sp"
        android:textColor="@color/text_hint" />

    <Spinner
        android:id="@+id/spinnerGesture"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/custom_gesture_wait"
        android:textSize="13sp"
        android:textColor="@color/text_hint" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderWait"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:valueFrom="0"
            android:valueTo="30"
            android:stepSize="1"
            android:value="2" />

        <TextView
            android:id="@+id/tvWait"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="@string/custom_gesture_wait_value"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvPosLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/custom_gesture_pos"
        android:textSize="13sp"
        android:textColor="@color/text_hint" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderX"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:valueFrom="5"
            android:valueTo="95"
            android:stepSize="5"
            android:value="50" />

        <TextView
            android:id="@+id/tvX"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="@string/custom_gesture_x_value"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderY"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:valueFrom="5"
            android:valueTo="95"
            android:stepSize="5"
            android:value="50" />

        <TextView
            android:id="@+id/tvY"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="@string/custom_gesture_y_value"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvDistLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/custom_gesture_dist"
        android:textSize="13sp"
        android:textColor="@color/text_hint" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderDist"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:valueFrom="20"
            android:valueTo="90"
            android:stepSize="5"
            android:value="70" />

        <TextView
            android:id="@+id/tvDist"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="@string/custom_gesture_dist_value"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
