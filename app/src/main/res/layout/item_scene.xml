<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/AutoScrollCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="18dp">

        <ImageView
            android:id="@+id/ivSceneIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/scene_icon_bg"
            android:padding="10dp"
            android:src="@drawable/ic_scene_video"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:id="@+id/tvSceneName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Title"
                android:textSize="15sp"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvSceneDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.Body"
                android:textSize="12sp"
                android:textColor="@color/text_hint" />

            <TextView
                android:id="@+id/tvSceneTags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="@style/TextAppearance.Body"
                android:textSize="11sp"
                android:textColor="@color/teal_700" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivSelected"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_check"
            android:contentDescription="@string/scene_selected"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
