<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_page">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="36dp">

        <!-- 使用说明卡片 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/AutoScrollCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/guide_title"
                    android:textAppearance="@style/TextAppearance.Title"
                    android:textSize="16sp"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/guide_content"
                    android:textAppearance="@style/TextAppearance.Body"
                    android:textSize="13.5sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 运行状态卡片 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/AutoScrollCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_title"
                    android:textAppearance="@style/TextAppearance.Title"
                    android:textSize="16sp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tvStatusAccessibility"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Status"
                    android:textSize="14sp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp" />

                <TextView
                    android:id="@+id/tvStatusOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Status"
                    android:textSize="14sp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp" />

                <TextView
                    android:id="@+id/tvStatusService"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Status"
                    android:textSize="14sp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp" />

                <TextView
                    android:id="@+id/tvStatusScrolling"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Status"
                    android:textSize="14sp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp" />

                <TextView
                    android:id="@+id/tvStatusScene"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Status"
                    android:textSize="14sp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvStatusRemaining"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Status"
                    android:textSize="14sp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 基础参数卡片 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/AutoScrollCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_title"
                        android:textAppearance="@style/TextAppearance.Title"
                        android:textSize="16sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnApplyRecommend"
                        style="@style/AutoScrollButton.Outline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/apply_recommend"
                        android:textSize="12sp"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        app:cornerRadius="12dp" />
                </LinearLayout>

                <!-- 最小间隔 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/min_interval"
                            android:textAppearance="@style/TextAppearance.Body"
                            android:textSize="13.5sp" />

                        <TextView
                            android:id="@+id/tvMinInterval"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/purple_700"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:paddingLeft="8dp" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderMinInterval"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="1"
                        android:valueTo="30"
                        android:stepSize="1"
                        app:tickColor="@color/purple_200"
                        app:tickColorActive="@color/purple_500"
                        app:thumbColor="@color/purple_500"
                        app:trackColorActive="@color/purple_500"
                        app:trackColorInactive="@color/divider" />
                </LinearLayout>

                <!-- 最大间隔 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/max_interval"
                            android:textAppearance="@style/TextAppearance.Body"
                            android:textSize="13.5sp" />

                        <TextView
                            android:id="@+id/tvMaxInterval"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/purple_700"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:paddingLeft="8dp" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderMaxInterval"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="2"
                        android:valueTo="60"
                        android:stepSize="1"
                        app:tickColor="@color/purple_200"
                        app:tickColorActive="@color/purple_500"
                        app:thumbColor="@color/purple_500"
                        app:trackColorActive="@color/purple_500"
                        app:trackColorInactive="@color/divider" />
                </LinearLayout>

                <!-- 最小时长 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/min_duration"
                            android:textAppearance="@style/TextAppearance.Body"
                            android:textSize="13.5sp" />

                        <TextView
                            android:id="@+id/tvMinDuration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/purple_700"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:paddingLeft="8dp" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderMinDuration"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="100"
                        android:valueTo="1500"
                        android:stepSize="50"
                        app:tickColor="@color/teal_200"
                        app:tickColorActive="@color/teal_700"
                        app:thumbColor="@color/teal_700"
                        app:trackColorActive="@color/teal_700"
                        app:trackColorInactive="@color/divider" />
                </LinearLayout>

                <!-- 最大时长 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/max_duration"
                            android:textAppearance="@style/TextAppearance.Body"
                            android:textSize="13.5sp" />

                        <TextView
                            android:id="@+id/tvMaxDuration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/purple_700"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:paddingLeft="8dp" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderMaxDuration"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="200"
                        android:valueTo="3000"
                        android:stepSize="50"
                        app:tickColor="@color/teal_200"
                        app:tickColorActive="@color/teal_700"
                        app:thumbColor="@color/teal_700"
                        app:trackColorActive="@color/teal_700"
                        app:trackColorInactive="@color/divider" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchFilterApp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/filter_app_title"
                    android:textAppearance="@style/TextAppearance.Body"
                    android:textSize="13.5sp"
                    app:useMaterialThemeColors="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginStart="4dp"
                    android:text="@string/filter_app_summary"
                    android:textAppearance="@style/TextAppearance.Body"
                    android:textSize="12sp"
                    android:textColor="@color/text_hint" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveSettings"
                    style="@style/AutoScrollButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/save"
                    app:backgroundTint="@color/teal_700"
                    app:cornerRadius="16dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 权限与服务操作 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAccessibility"
            style="@style/AutoScrollButton.Outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/btn_accessibility_off"
            app:strokeColor="@color/purple_500"
            android:textColor="@color/purple_700" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOverlay"
            style="@style/AutoScrollButton.Outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/btn_overlay_off"
            app:strokeColor="@color/teal_700"
            android:textColor="@color/teal_700" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartService"
            style="@style/AutoScrollButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/start_service"
            app:backgroundTint="@color/purple_500"
            app:cornerRadius="18dp" />

    </LinearLayout>
</ScrollView>
