<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 应用基础 -->
    <string name="app_name">自动刷视频</string>
    <string name="accessibility_service_description">此服务用于模拟用户滑动、点赞、关闭广告等操作，自动刷短视频/新闻/小说/社交/直播等内容。请确保只在需要时使用此功能。</string>

    <!-- 主界面标题与说明 -->
    <string name="app_headline">自动刷刷刷</string>
    <string name="app_subtitle">短视频 · 新闻 · 小说 · 社交 · 直播 · 全场景自动滚动</string>
    <string name="guide_title">使用说明</string>
    <string name="guide_content">1. 在「场景」页选择要刷的内容类型\n2. 在「任务」页开启需要的扩展功能\n3. 回到「控制」页授予无障碍 + 悬浮窗权限\n4. 点击「启动服务」→ 单击悬浮球开始\n5. 再次单击悬浮球停止</string>
    <string name="status_title">运行状态</string>
    <string name="settings_title">基础参数</string>

